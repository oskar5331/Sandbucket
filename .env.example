# Copy to .env. The values below are DEV-ONLY: they let the dev container and a
# local `docker compose up` start with no setup. Replace every secret before
# running anywhere reachable by anyone else. Variables: docs/setup-config.md §5.
# Generate secrets with: openssl rand -hex 32   (or -base64 32 where noted)

# Postgres superuser for the compose `postgres` service.
POSTGRES_PASSWORD=dev-only-postgres-password

# Roles sandbucket_app / sandbucket_owner (prd.md §19). The one-shot `db-init` service
# creates them from these two URLs, so the role names and passwords live only here.
# Use URL-safe passwords (openssl rand -hex 32): db-init refuses percent-encoding.
# sslmode=disable: the Compose Postgres has no TLS.
DATABASE_URL=postgres://sandbucket_app:dev-only-app-password@postgres:5432/sandbucket?sslmode=disable
DATABASE_OWNER_URL=postgres://sandbucket_owner:dev-only-owner-password@postgres:5432/sandbucket?sslmode=disable

# Platform admin seed (setup-config.md §2).
ADMIN_EMAIL=admin@example.test
ADMIN_INITIAL_PASSWORD=dev-only-admin-password
ALLOW_REGISTRATION=true

# better-auth (prd.md §21). Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me
# Public URL of the app: auth links and the storage CORS origin. Read at runtime on the
# server, never baked into the build (roadmap Q5).
APP_URL=http://localhost:3000

# Object storage: Garage locally (prd.md §20).
BUCKET_NAME=sandbucket-dev
# Inside Compose the server reaches the store by service name, while the browser
# reaches the published port, so presigned URLs are signed against the public one.
AWS_ENDPOINT_URL_S3=http://garage:3900
S3_PUBLIC_ENDPOINT_URL=http://localhost:3900
AWS_REGION=garage
AWS_ACCESS_KEY_ID=GKsandbucketdevonly
AWS_SECRET_ACCESS_KEY=dev-only-garage-secret-key-change-me
# Garage node secret: exactly 32 bytes hex (openssl rand -hex 32).
GARAGE_RPC_SECRET=dededededededededededededededededededededededededededededededede
GARAGE_ADMIN_TOKEN=dev-only-garage-admin-token

# Email (prd.md §22): any SMTP server or relay. Wired in M2.
SMTP_URL=
EMAIL_FROM=sandbucket@example.test
